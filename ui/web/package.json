    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.8",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.neo.app",
    "productName": "N.E.O.",
    "win": {
      "icon": "../../jarvis_icon.ico",
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
