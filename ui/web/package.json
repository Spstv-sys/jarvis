{
  "name": "neo-hud",
  "version": "1.0.0",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": ".\\node_modules\\.bin\\electron .",
