# ---------------------------------------------------------------------------
# JARVIS — приклад змінних середовища
# Скопіюйте цей файл як .env і заповніть свої значення
# ---------------------------------------------------------------------------

# --- Сервер ---
API_PORT=8001

# --- Шлях для автосортування файлів ---
JARVIS_DRIVE=H:\Jarvis_Sorted

# --- OpenAI ---
OPENAI_API_KEY=...

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Ollama (локальна модель) ---
# Для локального запуску (RUN_JARVIS.bat + docker-compose.yml):
OLLAMA_HOST=http://localhost:11434
# Для серверного режиму (docker-compose.server.yml) змінити на:
# OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3

# Дозволені CORS origins (через кому)
ALLOWED_ORIGINS=http://localhost:5173

# Шлях до Tesseract OCR
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Папка з секретними файлами
JARVIS_SECRET_DIR=H:\Sicrets

# Максимум файлів для масового читання
JARVIS_LEARN_MAX_FILES=5

# DeepSeek API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# REST API security key (optional — if set, POST /command and WebSocket /ws require ?token=KEY)
JARVIS_API_KEY=your_api_key_here

# Per-IP rate limit for POST /command (requests per 60 s)
JARVIS_RATE_LIMIT=30
